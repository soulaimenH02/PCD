## ✂️ Cell 5 — Trim Background to Exactly Match Bird Count

TARGET   = sum(wav_count(os.path.join(DATASET_PATH, b)) for b in BIRDS)
bg_files = list(Path(BACKGROUND_DIR).glob('*.wav'))
bg_count = len(bg_files)

print(f'🐦 Bird files       : {TARGET:,}')
print(f'📁 Background files : {bg_count:,}')

if bg_count > TARGET:
    random.shuffle(bg_files)
    for f in bg_files[:bg_count - TARGET]:
        os.remove(f)
    print(f'✂️  Removed {bg_count - TARGET:,} files — background now exactly {TARGET:,}')
elif bg_count == TARGET:
    print('✅ Already perfectly balanced!')
else:
    print(f'⚠️  Still {TARGET - bg_count:,} short — re-run Cell 4')

