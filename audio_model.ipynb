## 🔧 Cell 6 — Convert All Audio → 16-bit 16 kHz Mono

Also creates the required `_background_noise_/silence.wav` that TF speech_commands needs.

# 1. Create silence file
noise_dir = os.path.join(DATASET_PATH, '_background_noise_')
os.makedirs(noise_dir, exist_ok=True)
with wave.open(os.path.join(noise_dir, 'silence.wav'), 'w') as wf:
    wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(16000)
    wf.writeframes(np.zeros(16000 * 10, dtype=np.int16).tobytes())
print('✅ Silence file created')

# 2. Convert all class audio files
CLASSES  = BIRDS + ['background']
converted, errors = 0, 0

for cls in CLASSES:
    cls_path = Path(DATASET_PATH) / cls
    if not cls_path.exists():
        print(f'⚠️  Skipping {cls} — folder not found'); continue
    wavs = list(cls_path.glob('*.wav'))
    print(f'🔄 {cls}: {len(wavs):,} files...')
    for wav_file in wavs:
        try:
            with wave.open(str(wav_file), 'r') as w:
                p = w.getparams()
                frames = w.readframes(p.nframes)
            if   p.sampwidth == 1:
                audio = (np.frombuffer(frames, dtype=np.uint8).astype(np.int16) - 128) * 256
            elif p.sampwidth == 2:
                audio = np.frombuffer(frames, dtype=np.int16)   # already correct
            elif p.sampwidth == 4:
                audio = (np.frombuffer(frames, dtype=np.int32) / 65536).astype(np.int16)
            else:
                errors += 1; continue
            with wave.open(str(wav_file), 'w') as w:
                w.setnchannels(p.nchannels); w.setsampwidth(2)
                w.setframerate(p.framerate); w.writeframes(audio.tobytes())
            converted += 1
            if converted % 2000 == 0:
                print(f'  ✓ {converted:,} converted...')
        except:
            errors += 1

print(f'\n✅ Done!  Converted: {converted:,}  |  Errors: {errors}')

