## 📊 Cell 3 — Audit Dataset

# ─── Globals used by all later cells ──────────────────────────
BIRDS          = ['pigeons', 'sparrows', 'starlings']
BACKGROUND_DIR = os.path.join(DATASET_PATH, 'background')
os.makedirs(BACKGROUND_DIR, exist_ok=True)

def wav_count(folder):
    p = Path(folder)
    return len(list(p.glob('*.wav'))) if p.exists() else 0

def audit():
    total = 0
    print('📊 ── Dataset Audit ──────────────────')
    for bird in BIRDS:
        n = wav_count(os.path.join(DATASET_PATH, bird))
        total += n
        status = '✅' if n > 0 else '❌ MISSING'
        print(f'  🐦 {bird:<12}: {n:>6,}  {status}')
    bg = wav_count(BACKGROUND_DIR)
    print(f'  📁 {"background":<12}: {bg:>6,}')
    print(f'  {"─"*35}')
    print(f'  🎯 Target background : {total:>6,}')
    gap = total - bg
    if gap <= 0:
        print('  ✅ BALANCED!')
    else:
        print(f'  ⚠️  Need {gap:,} more background files')
    return total, bg

TOTAL_BIRDS, BG_COUNT = audit()

