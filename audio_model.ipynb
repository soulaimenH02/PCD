## 🎵 Cell 4 — Download & Generate Background Audio

Downloads free audio datasets and slices them into 1-second 16 kHz mono chunks.
Stops automatically the moment the background folder matches your bird count.

**Order:** FSD50K dev → FSD50K eval → ESC-50 (fallback)

TARGET = sum(wav_count(os.path.join(DATASET_PATH, b)) for b in BIRDS)
print(f'🎯 Target: {TARGET:,} background files\n')

# ── helpers ───────────────────────────────────────────────────
def count_bg():
    return len(list(Path(BACKGROUND_DIR).glob('*.wav')))

def slice_file(src):
    """Slice one source file into 1-sec mono 16kHz chunks, stop if target met."""
    try:
        r = subprocess.run(
            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
             '-of', 'default=noprint_wrappers=1:nokey=1', str(src)],
            capture_output=True, text=True, timeout=10
        )
        duration = float(r.stdout.strip() or 0)
        n = max(1, int(duration))
        count = 0
        for i in range(n):
            if count_bg() >= TARGET:
                break
            out = os.path.join(BACKGROUND_DIR, f'{src.stem}_chunk{i:04d}.wav')
            if os.path.exists(out):
                count += 1; continue
            subprocess.run([
                'ffmpeg', '-y', '-loglevel', 'error',
                '-ss', str(i), '-t', '1', '-i', str(src),
                '-ac', '1', '-ar', '16000', '-sample_fmt', 's16', out
            ], check=True, timeout=15)
            count += 1
        return count
    except:
        return 0

def run_dir(src_dir, patterns=('*.wav',), workers=6):
    files = []
    for p in patterns:
        files += list(Path(src_dir).rglob(p))
    if not files:
        print('  ⚠️  No audio files found'); return 0
    print(f'  📂 {len(files):,} source files found')
    start, total = time.time(), 0
    with ThreadPoolExecutor(max_workers=workers) as ex:
        futures = {ex.submit(slice_file, f): f for f in files}
        for done_i, fut in enumerate(as_completed(futures), 1):
            total += fut.result()
            if done_i % 300 == 0 or done_i == len(files):
                elapsed = time.time() - start
                rate    = done_i / max(elapsed, 1)
                eta     = (len(files) - done_i) / max(rate, 0.001)
                print(f'  ↳ {done_i}/{len(files)} | {count_bg():,} chunks | '
                      f'{rate:.1f} files/s | ~{eta/60:.1f} min left')
            if count_bg() >= TARGET:
                print('  🎉 Target reached — stopping early'); break
    return total

def fetch_and_slice(name, url, dest, extract_cmd, src_dir,
                    patterns=('*.wav',), cleanup=''):
    if count_bg() >= TARGET:
        print(f'✅ Already balanced — skipping {name}'); return 0
    print(f"\n{'='*55}\n📥 {name} | {count_bg():,} / {TARGET:,}\n{'='*55}")
    if os.system(f"wget -q --show-progress '{url}' -O '{dest}'") != 0:
        print('  ❌ Download failed'); return 0
    print('  Extracting...')
    os.system(extract_cmd)
    added = run_dir(src_dir, patterns)
    if cleanup:
        os.system(f'rm -rf {cleanup}')
    print(f'  ✅ +{added:,} | Total: {count_bg():,} | Need: {max(0,TARGET-count_bg()):,}')
    return added

# ── Download sources ──────────────────────────────────────────
grand = 0

grand += fetch_and_slice(
